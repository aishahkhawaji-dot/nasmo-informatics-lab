# Copy this file to  .streamlit/secrets.toml  (same folder) and fill in the values.
# Leave everything out to run in local mode (data saved on this computer only).

# SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_KEY = "the service_role key from Supabase > Project Settings > API"

# Optional: the code needed to create the FIRST teacher account.
# If you leave it out, the app creates one and saves it in data/setup_code.txt
# NASMO_SETUP_CODE = "choose-a-long-private-code"
